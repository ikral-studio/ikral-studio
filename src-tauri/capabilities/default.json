{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de IKRAL Studio: tu carpeta de usuario y los discos externos (para guardar bibliotecas .ikral donde quieras)",
  "windows": [
    "main",
    "gpt"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "dialog:default",
    "drag:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "/Volumes"
        },
        {
          "path": "/Volumes/**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:allow-copy-file"
  ]
}
