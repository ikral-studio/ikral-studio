{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de IKRAL Studio: solo la carpeta Documentos/IKRAL Studio",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "drag:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/IKRAL Studio"
        },
        {
          "path": "$DOCUMENT/IKRAL Studio/**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:allow-copy-file"
  ]
}